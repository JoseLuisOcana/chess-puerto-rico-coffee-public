diff --git a/compose-search.yml b/compose-search.yml
index 62447c7..96780eb 100644
--- a/compose-search.yml
+++ b/compose-search.yml
@@ -8,10 +8,15 @@ services:
       - http.cors.allow-origin=/.*/
       - http.cors.enabled=true
       - xpack.security.enabled=false
+      - ES_JAVA_OPTS=-Xms512m -Xmx512m
     volumes:
       - ./conf/elasticsearch/synonyms:/usr/share/elasticsearch/config/synonyms
+      - es_data:/usr/share/elasticsearch/data
     ports:
-      - 9200:9200
+      # 2026-09-13: loopback-bound. Published on 0.0.0.0 these were internet-reachable
+      # (docker DNATs in PREROUTING, bypassing the host's INPUT DROP policy). Every
+      # consumer addresses this service by its docker service name, never the host port.
+      - 127.0.0.1:9200:9200
     profiles:
       - search
   elasticvue:
@@ -20,11 +25,16 @@ services:
     volumes:
       - ./conf/elasticvue.json:/usr/share/nginx/html/api/default_clusters.json
     ports:
-      - 8092:8080
+      # 2026-09-13: loopback-bound. Published on 0.0.0.0 these were internet-reachable
+      # (docker DNATs in PREROUTING, bypassing the host's INPUT DROP policy). Every
+      # consumer addresses this service by its docker service name, never the host port.
+      - 127.0.0.1:8092:8080
     profiles:
       - search
   lila_search_app:
-    image: ghcr.io/lichess-org/lila-search-app:latest
+    # 2026-10-08: pinned to lila-search 3.6.0 (= the search client our lila uses). Was :latest = 3.4.3, whose
+    # ingestor never saw a blog post's rating/date. Bump deliberately; then `sudo chess-search-rebuild.sh --rebuild`.
+    image: ghcr.io/lichess-org/lila-search-app:3.6.0@sha256:1d4ab5729b5c0b9a0bfefc4bcf98e63077c14f62bffdc1bc564e397954a3d3de
     volumes:
       - ./conf/lila-search-logback.xml:/opt/config/logback.xml
     environment:
@@ -40,7 +50,9 @@ services:
     profiles:
       - search
   lila_search_ingestor:
-    image: ghcr.io/lichess-org/lila-search-ingestor-app:latest
+    # 2026-10-08: pinned to lila-search 3.6.0 (= the search client our lila uses). Was :latest = 3.4.3, whose
+    # ingestor never saw a blog post's rating/date. Bump deliberately; then `sudo chess-search-rebuild.sh --rebuild`.
+    image: ghcr.io/lichess-org/lila-search-ingestor-app:3.6.0@sha256:9b19cbfafdc615554e43e9f7c7d92b72ff3150517b0657d06c70de65ab720cc4
     volumes:
       - ./conf/lila-search-logback.xml:/opt/config/logback.xml
     environment:
@@ -56,16 +68,26 @@ services:
       - INGESTOR_TEAM_TIME_WINDOWS=1
       - INGESTOR_STUDY_BATCH_SIZE=100
       - INGESTOR_STUDY_INTERVAL=30
+      # 2026-10-08: the study watcher polls 30-s windows. Started WITHOUT a saved position (a freshly created container:
+      # the position store is /tmp inside it) it queries [now, now+30 s] at "now" - always empty, forever (upstream bug,
+      # 3.4.3 and 3.6.0). A fixed start makes every start re-check studies changed since then, then poll correctly.
+      - INGESTOR_STUDY_START_AT=1791504000
       - INGESTOR_GAME_BATCH_SIZE=100
       - INGESTOR_GAME_TIME_WINDOWS=2
-      - INGESTOR_GAME_START_AT=0
+      # 2026-10-02: INGESTOR_GAME_START_AT=0 removed here (kept for the one-off _cli service below). It
+      # OVERRIDES the saved resume position, so the game ingestor restarted its change stream from 1970 on
+      # every start - which only works while the oplog still holds the replica set's very first entry. The
+      # 6.2M-puzzle import rotated the oplog for the first time -> ChangeStreamHistoryLost (286) -> crash loop.
+      # Unset = resume from the saved position, else from now (like the forum/team/ublog ingestors).
       - JAVA_TOOL_OPTIONS=-Dlogback.configurationFile=/opt/config/logback.xml
       - KV_STORE_PATH=/tmp/json.store
     restart: unless-stopped
     profiles:
       - search
   lila_search_ingestor_cli:
-    image: ghcr.io/lichess-org/lila-search-ingestor-cli:latest
