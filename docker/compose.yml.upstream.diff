+volumes:
+  # Recovery 2026-05-25: pin mongodb /data/db to the real data volume.
+  # Previously /data/db was an anonymous volume (mongo image VOLUME), so each
+  # container recreation (reboot / compose up) grabbed a fresh EMPTY volume and
+  # orphaned the real data. external:true => compose never creates/deletes it,
+  # and it survives even `down -v`.
+  mongo_data_primary:
+    external: true
+    name: lila_mongo_data_primary_20260913
+
+  # Pinned 2026-09-13: redis /data was an UNDECLARED anonymous volume (redis image
+  # VOLUME), so every container recreation swapped it for a fresh empty one and
+  # orphaned the old — the same trap as mongodb above. external:true pins it to the
+  # volume currently in use and stops compose ever creating or deleting it.
+  redis_data:
+    external: true
+    name: 9ecacfab0339b71f9a366529ef533ea92a6706a8e2578e38e12748b3106c0a25
