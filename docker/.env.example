USER_ID=0
GROUP_ID=0
LILA_DOMAIN=your-domain.example
LILA_URL=https://your-domain.example
COMPOSE_PROFILES=base,stockfish-play,stockfish-analysis,search,gifs,external-engine,push,thumbnails,email
MOCK_EMAIL=false
ENABLE_MONITORING=false
MAILER_PASSWORD=CHANGEME

# 2026-09-13: lila secrets moved out of conf/lila.conf so that file is safe to track.
# compose.yml passes these six to the lila container; conf/lila.conf reads them as ${?LILA_...}.
# Generate your own values - never reuse anyone else's:
#   bpass secret (AES key for the stored password hashes; changing it later breaks every password): openssl rand -base64 32
#   the four token secrets (login link, email change, email confirm, password reset):          openssl rand -hex 32
LILA_BPASS_SECRET=REPLACE_WITH_BASE64_32_BYTES
LILA_EMAIL_CONFIRM_SECRET=REPLACE_WITH_RANDOM_64_HEX
LILA_PASSWORD_RESET_SECRET=REPLACE_WITH_RANDOM_64_HEX
LILA_EMAIL_CHANGE_SECRET=REPLACE_WITH_RANDOM_64_HEX
LILA_LOGIN_TOKEN_SECRET=REPLACE_WITH_RANDOM_64_HEX
# lichess.org personal API token for the public opening explorer (explorer.oauth_token in conf/lila.conf)
LILA_EXPLORER_OAUTH_TOKEN=REPLACE_WITH_YOUR_LICHESS_ORG_API_TOKEN
