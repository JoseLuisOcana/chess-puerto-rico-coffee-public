+# 2026-09-13: trust the reverse-proxy chain so lila sees REAL client IPs.
+# Without this, every one of lila's ~28 IP-keyed rate limiters keyed on the Caddy
+# container's docker IP (verified: every ratelimit line in all.log read 172.18.0.4),
+# collapsing them into a single global bucket. That is an availability bug, not just a
+# weak control - on 2026-08-11 one client exhausted a 15/min image-export budget shared
+# by every visitor.
+#
+# SAFE ONLY BECAUSE the proxy ports are not externally reachable (verified 2026-09-13):
+#   - compose.yml binds 8080/9664 to 127.0.0.1, so the DNAT rule is scoped -d 127.0.0.1/32
+#   - DOCKER-USER drops external traffic to those ports (docker-port-guard.service)
+#   - lila's own :9663 is never published on the host
+# If any of those change, X-Forwarded-For becomes spoofable and this must be reverted.
+# Chain is: client -> nginx (adds X-Forwarded-For) -> 127.0.0.1:8080 -> Caddy -> lila:9663
+play.http.forwarded.version = x-forwarded
+play.http.forwarded.trustedProxies = ["172.18.0.0/16", "127.0.0.1", "::1"]
+
+# lila base.conf ships a PUBLIC cookie-signing key; with it, a forged signed session ("email_confirm=<user>:<email>")
+# can take over accounts awaiting email confirmation (GHSA-622v-64xr-xvm9). Set your own random key
+# (e.g. `openssl rand -hex 64`), keep it private. Changing it logs everyone out once; lila-ws does not use it.
+play.http.secret.key = "REPLACE_WITH_RANDOM_128_HEX"
