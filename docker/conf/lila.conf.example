include "base"
include "version"

user.password.bpass.secret = ${?LILA_BPASS_SECRET}
security.email_confirm.secret  = ${?LILA_EMAIL_CONFIRM_SECRET}
security.password_reset.secret = ${?LILA_PASSWORD_RESET_SECRET}
security.email_change.secret   = ${?LILA_EMAIL_CHANGE_SECRET}
security.login_token.secret    = ${?LILA_LOGIN_TOKEN_SECRET}
# 2026-10-02: was "lila" (shown in page titles + header; nginx sub_filters patched over it)
net.site.name = "Chess Puerto Rico Coffee"
net.domain = ${?LILA_DOMAIN}
net.socket.domains = [ ${?LILA_DOMAIN} ]
net.asset.base_url = ${?LILA_URL}
net.base_url = ${?LILA_URL}
net.ratelimit = ${?ENABLE_RATE_LIMITING}

mongodb.uri = "mongodb://mongodb?appName=lila"
redis.uri = "redis://redis"

game.gifUrl = "http://lila_gif:6175"

search.enabled = true
search.endpoint = "http://lila_search_app:9673"

memo.picfit.endpointGet = ${?LILA_URL}
memo.picfit.endpointPost = "http://picfit:3001"
# 2026-10-02: request-signing key shared with conf/picfit.json "secret_key" (must be identical).
# Replaces the PUBLIC upstream default in base.conf, which let anyone sign /display URLs. Literal here, not
# ${?ENV}: an env var needs a container recreate, which would drop the sbt/coursier caches.
memo.picfit.secretKey = "REPLACE_WITH_RANDOM_64_HEX__SAME_AS_picfit.json_secret_key"

mailer.primary.mock     = ${?MOCK_EMAIL}
mailer.primary.tls      = true
mailer.primary.host     = "smtp.ionos.com"
mailer.primary.port     = 587
mailer.primary.user     = "system@chesspuertoricocoffee.com"
mailer.primary.password = ${?MAILER_PASSWORD}
mailer.primary.sender   = "Chess Puerto Rico Coffee <system@chesspuertoricocoffee.com>"
security.email_confirm.enabled = true

push.firebase.mobile.url = "https://fcm.googleapis.com/v1/projects/lichess-testing-df65f/messages:send"
push.firebase.mobile.json = "/opt/firebase-service-account.json"
push.web.url = "http://lila_push:9054"
push.web.vapid_public_key = "BDTVzVZ3_f83JgH1SJmZrhg-FNZ36Sixc_zrR1-1ZGVHUPmFeU6Q_-JQLN8NF5niYW_1jRU47aPczYA0FbgUCus="

swiss.bbpairing = "/opt/bbpPairings/bbpPairings.exe"

kamon.enabled = ${?ENABLE_MONITORING}
kamon.influxdb.hostname = "influxdb"
kamon.influxdb.authentication.token = "secret"
kamon.metric.tick-interval = 2 seconds
kamon.prometheus.lilaKey = "x"

plan.stripe.keys.public = "pk_test_123"
plan.stripe.keys.secret = "sk_test_123"
plan.payPal.keys.public = "sb"

streamer.twitch.endpoint = "http://caddy/static/twitch-streamers.json"
streamer.twitch.client_id = "twitch-client-id"
streamer.twitch.secret = "twitch-secret"

hcaptcha.enabled = false
hcaptcha.public_key = "10000000-ffff-ffff-ffff-000000000001"
hcaptcha.private_key = "CHANGEME_HCAPTCHA_PRIVATE_KEY"

# Task 6+7: Opening explorer + tablebase via public lichess endpoints
explorer.internal_endpoint = "https://explorer.lichess.ovh"
explorer.endpoint = "https://explorer.lichess.ovh"
explorer.oauth_token = ${?LILA_EXPLORER_OAUTH_TOKEN}
explorer.tablebase_endpoint = "https://tablebase.lichess.ovh"

# 2026-09-13: trust the reverse-proxy chain so lila sees REAL client IPs.
# Without this, every one of lila's ~28 IP-keyed rate limiters keyed on the Caddy
# container's docker IP (verified: every ratelimit line in all.log read 172.18.0.4),
# collapsing them into a single global bucket. That is an availability bug, not just a
# weak control - on 2026-08-11 one client exhausted a 15/min image-export budget shared
# by every visitor.
#
# SAFE ONLY BECAUSE the proxy ports are not externally reachable (verified 2026-09-13):
#   - compose.yml binds 8080/9664 to 127.0.0.1, so the DNAT rule is scoped -d 127.0.0.1/32
#   - DOCKER-USER drops external traffic to those ports (docker-port-guard.service)
#   - lila's own :9663 is never published on the host
# If any of those change, X-Forwarded-For becomes spoofable and this must be reverted.
# Chain is: client -> nginx (adds X-Forwarded-For) -> 127.0.0.1:8080 -> Caddy -> lila:9663
play.http.forwarded.version = x-forwarded
play.http.forwarded.trustedProxies = ["172.18.0.0/16", "127.0.0.1", "::1"]
