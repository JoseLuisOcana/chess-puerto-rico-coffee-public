# /etc/cron.d/chess-mongodump
#
# 2026-10-02: nightly logical backup of the chesspuertoricocoffee.com MongoDB (lila-docker).
# 01:15 AST (since 2026-11-15, BUTTON 187; was 03:30): before the 02:00 Acronis image, so the off-server copy always holds
# the newest dump; also before the 04:15 daily-puzzle recycle. Takes ~3 s. 14-day retention in /var/backups/chess-mongo/.
# Every archive is read-back verified before it is kept. See /usr/local/bin/chess-mongodump.sh.
# Silent on success (log: /var/log/chess-mongodump.log); cron mails on any failure.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=admin@example.com   # sanitized: set your admin address

15 1 * * * root /usr/local/bin/chess-mongodump.sh
