def container_env_matches(keys):
    r = run(["docker", "inspect", "-f", "{{json .Config.Env}}", LILA_C], 20)
    try:
        env = dict(e.split("=", 1) for e in json.loads(r.stdout))
    except Exception:
        return False
    for path, key, pat in plan_edits(MODE):
        if path == ENV and env.get(key) != current_value(path, key, pat):
            return False
    return True


def dry_run_ok():
    dry = run(DC + ["up", "-d", "--no-deps", "--dry-run", "lila"], 180)
    names = set(re.findall(r"Container (\S+)", dry.stdout + dry.stderr))
    return dry.returncode == 0 and names == {LILA_C}, names, dry.returncode


def recreate_lila():
    ok, names, rc = dry_run_ok()
    if not ok:
        stop(f"the compose dry run would touch {sorted(names) or 'nothing'} (exit {rc}) - lila NOT recreated")
    if container_env_matches(None) and lila_mode_now()[0] == "Dev" and homepage_ok() and site_in() >= 1:
        say("   lila already runs with the new value (an earlier run recreated it) - no recreate needed")
        log("lila already current")
        return
    say("   lila: recreating (the site is down for ~15 s) ...")
    log("lila recreate")
    before = run(["docker", "inspect", "-f", "{{.Id}} {{.State.StartedAt}}", LILA_C], 20).stdout.strip()
    t0 = time.time()
    up = run(DC + ["up", "-d", "--no-deps", "lila"], 300)
    upfail = "" if up.returncode == 0 else ("timeout after 300 s" if up.returncode == 124 else f"exit {up.returncode}")
    after = run(["docker", "inspect", "-f", "{{.Id}} {{.State.StartedAt}}", LILA_C], 20).stdout.strip()
    if not upfail and after and after == before:
        stop("compose did not recreate lila (same container and start) - it saw no change in .env")
    # from here on, WHATEVER compose said: lila keeps running only when this start is confirmed Dev (owner's rule)
    mode, t1 = "none", time.time()   # the Dev window starts when compose has returned
    while True:
        try:
            mode, _ = lila_mode_now()
        except Exception:
            mode = "none"
        if mode != "none" or time.time() - t1 >= 240:
            break
        time.sleep(3)
    if mode != "Dev":
        say(f"   lila's new start is NOT confirmed Dev (read: {mode}) - stopping lila (owner's rule: only a confirmed Dev lila keeps running)")
        stop_lila_verified()
        stop("lila was stopped (verified) because Dev mode was not confirmed - look at `sudo docker logs --tail 50 lila-docker-lila-1`")
    say("   lila Dev CONFIRMED for its new start")
    if upfail:
        stop(f"docker compose up for lila reported a failure ({upfail}); lila is running and Dev - look before going on")
    while time.time() - t0 < 300:
        if homepage_ok() and site_in() >= 1:
            break
        time.sleep(3)
    else:
        stop("lila started (Dev) but the homepage / site-in did not come back within 5 minutes")
    say(f"   homepage 200 + site-in subscribed, {int(time.time() - t0)} s after the recreate")
    if not container_env_matches(None):
        stop("the running lila does not hold the value from .env")
    say("   the running lila holds the new value (compared in memory, not shown)")
    log(f"lila recreated OK Dev {int(time.time() - t0)}s")


def rebuild_sasl_db():
    """postmap into a PRIVATE copy next to the live file, check EVERY entry, then rename over the live .db (same owner/mode)"""
    st = os.stat(SASL + ".db")
    entries = [l.split() for l in open(SASL).read().split("\n") if l.strip() and not l.lstrip().startswith("#")]
    tdir = tempfile.mkdtemp(prefix=".b245-", dir=os.path.dirname(SASL))
    tsrc = os.path.join(tdir, "sasl_passwd")
    try:
        shutil.copyfile(SASL, tsrc)
        os.chmod(tsrc, 0o600)
        r = run(["/usr/sbin/postmap", tsrc], 60)
        if r.returncode != 0:
            stop(f"postmap of the private copy failed (exit {r.returncode}) - the live sasl_passwd.db is unchanged")
        for k, v in entries:
            q = run(["/usr/sbin/postmap", "-q", k, "hash:" + tsrc], 30)
            if q.returncode != 0 or q.stdout.strip() != v:
                stop(f"the rebuilt database does not hold the entry for {k} - the live sasl_passwd.db is unchanged")
        os.chown(tsrc + ".db", st.st_uid, st.st_gid)
        os.chmod(tsrc + ".db", stat.S_IMODE(st.st_mode))
        os.replace(tsrc + ".db", SASL + ".db")
    finally:
        for f in (tsrc + ".db", tsrc):
            if os.path.exists(f):
                os.unlink(f)
        os.rmdir(tdir)
    for k, v in entries:
        q = run(["/usr/sbin/postmap", "-q", k, "hash:" + SASL], 30)
        if q.returncode != 0 or q.stdout.strip() != v:
            stop(f"the live sasl_passwd.db does not answer the entry for {k}")
    return len(entries)


