#!/usr/bin/python3 -I
"""chess-secret-set - put a NEW chess secret into every place that uses it, typed hidden (BUTTON 245, 2026-11-25).

  sudo chess-secret-set mail       the IONOS password of system@chesspuertoricocoffee.com (change it in IONOS FIRST)
  sudo chess-secret-set explorer   a new lichess.org API token for the opening explorer (make it on lichess.org FIRST)
  sudo chess-secret-set --check    checks every file it would change; asks nothing, changes nothing

The secret is typed twice with hidden typing (getpass). It is never printed, never logged, never put on any command line
(the process list shows only "chess-secret-set mail"), never written anywhere except the files below.
Before anything is written the NEW value is tested: mail = a real login to smtp.ionos.com (no e-mail is sent);
explorer = lichess.org's own token test. If IONOS / lichess refuses it, NOTHING is changed.

mail     -> /opt/chess/lila-docker/.env MAILER_PASSWORD, /etc/chess-contact.env SMTP_PASS, the system@ line of
            /etc/postfix/sasl_passwd (the logbook@ line is never touched) + postmap + postfix reload,
            then lila is recreated (~15 s), chess-contact restarted, and `stuck-mail-check --logins` runs.
explorer -> /opt/chess/lila-docker/.env LILA_EXPLORER_OAUTH_TOKEN, then lila is recreated (~15 s).
Copies of every file BEFORE the change: /root/button245-20261125/runs/<time>-<mode>/before/ (root only).
BUTTON 236's compose-inputs record gets the new .env checksum (only .env may differ).
Log (no values): /var/log/chess-secret-set.log
"""
import fcntl, getpass, hashlib, http.client, json, os, re, shutil, signal, smtplib, ssl, stat, subprocess, sys, tempfile, time, warnings

L = "/opt/chess/lila-docker"
ENV = L + "/.env"
CONTACT = "/etc/chess-contact.env"
SASL = "/etc/postfix/sasl_passwd"
SASL_KEY = "[smtp.ionos.com]:587"
USER = "system@chesspuertoricocoffee.com"
B236 = "/root/button236-20261124/compose-inputs.sha256"
RUNS = "/root/button245-20261125/runs"
LOG = "/var/log/chess-secret-set.log"
LOCK = "/run/lock/chess-secret-set.lock"
OTHER_LOCKS = ["/run/lock/chess-upgrade-20261125.lock"]
DC = ["docker", "compose", "-p", "lila-docker", "--project-directory", L, "-f", L + "/compose.yml"]
LILA_C = "lila-docker-lila-1"
# characters that every one of the 3 file formats keeps exactly as typed (.env unquoted, systemd EnvironmentFile, Postfix map)
SAFE_PW = re.compile(r"[!%&()*+,\-./0-9:<>?@A-Z\[\]^_a-z{|}~]{12,128}")
SAFE_TOKEN = re.compile(r"[A-Za-z0-9_]{16,128}")
STAMP = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
for _k in ("COMPOSE_FILE", "COMPOSE_PROJECT_NAME", "COMPOSE_PROFILES", "COMPOSE_ENV_FILES", "DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG"):
    os.environ.pop(_k, None)   # docker / compose must see exactly the live project, never an override from the caller
warnings.simplefilter("error", getpass.GetPassWarning)   # never fall back to VISIBLE typing
SECRET = None   # the new value once typed: say() / log() replace it if it ever reaches a message


os.umask(0o077)   # every file this creates (log, status, copies) is root-only


def red(msg):
    msg = str(msg)
    return msg.replace(SECRET, "[REDACTED]") if SECRET else msg


def log(msg):
    if CHECK_ONLY:
        return   # --check writes nothing
    msg = red(msg)
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {MODE} {msg}\n")


def say(msg):
    try:
        print(red(msg), flush=True)
    except OSError:
        pass   # the terminal went away (SSH drop): keep going, the log has every step


def refuse(msg):
    say(f"REFUSED: {msg} - NOTHING changed")
    try:
        log(f"REFUSED {msg}")
    except OSError:
        pass
    sys.exit(2)


def stop(msg):
    say(f"STOP: {msg}")
    say("   The files written so far keep the NEW value (it was tested and works). Look at the step above, fix it, then run")
    say("   the command again with the same value - it is safe to repeat.")
    log(f"STOP {msg}")
    sys.exit(1)


def sha(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()


def run(cmd, timeout=120, **kw):
    """argv never holds a secret (checked by the callers' design: only paths, names, fixed words). A timeout is an answer
    (exit 124), never an exception: no step after the recreate may skip the Dev check / verified stop."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 124, "", "timeout")


# ---------------------------------------------------------------- file edits
def find_line(path, pat):
    lines = open(path, "rb").read().decode("utf-8").split("\n")
    idx = [i for i, l in enumerate(lines) if pat(l)]
    return lines, idx


def env_pat(key):
    return lambda l: re.match(rf"^\s*{key}\s*=", l) is not None


def env_value(line):
    v = line.split("=", 1)[1]
    q = v[:1] if v[:1] in ("'", '"') and v.endswith(v[:1]) and len(v) >= 2 else ""
    return (v[1:-1] if q else v), q


def sasl_pat(l):
    f = l.split()
    return len(f) == 2 and f[0] == SASL_KEY and f[1].startswith(USER + ":")


def plan_edits(mode):
    """[(path, key-or-None, line-matcher, new-line-builder)] - checked in --check and before writing"""
    if mode == "mail":
        return [
            (ENV, "MAILER_PASSWORD", env_pat("MAILER_PASSWORD")),
            (CONTACT, "SMTP_PASS", env_pat("SMTP_PASS")),
            (SASL, None, sasl_pat),
        ]
    return [(ENV, "LILA_EXPLORER_OAUTH_TOKEN", env_pat("LILA_EXPLORER_OAUTH_TOKEN"))]


def check_files(mode):
    for path, key, pat in plan_edits(mode):
        st = os.stat(path)
        if st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o077:
            refuse(f"{path} is not root-only (mode {stat.S_IMODE(st.st_mode):o}, uid {st.st_uid})")
        lines, idx = find_line(path, pat)
        if len(idx) != 1:
            refuse(f"{path}: expected exactly 1 {'line ' + key if key else 'system@ line'}, found {len(idx)}")
    if mode == "mail":
        st = os.lstat(SASL + ".db")
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o077:
            refuse(f"{SASL}.db is not a root-only regular file (mode {stat.S_IMODE(st.st_mode):o}) - the new password would go into it")
        lines, idx = find_line(SASL, lambda l: l.strip() and not l.lstrip().startswith("#"))
        if len(idx) != 2:
            refuse(f"{SASL}: expected 2 entries (system@ + logbook@), found {len(idx)} - look first")
    if not os.path.isfile(B236):
        refuse(f"BUTTON 236's record {B236} is missing")
    check_b236(allow_env=True)


def check_b236(allow_env):
    """every line of BUTTON 236's compose-inputs record must match the file now (only .env may differ when allow_env)"""
    for line in open(B236).read().splitlines():
        h, p = line.split("  ", 1)
        if sha(p) != h and not (allow_env and p == ENV):
            refuse(f"{p} differs from BUTTON 236's compose-inputs record - a compose input changed outside this command; look first")


def renew_b236():
    out, changed = [], False
    for line in open(B236).read().splitlines():
        h, p = line.split("  ", 1)
        now = sha(p)
        if p != ENV and now != h:
            stop(f"{p} changed outside this command - BUTTON 236's record NOT renewed")
        changed |= (now != h)
        out.append(f"{now}  {p}")
    tmp = B236 + ".b245tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(out) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, B236)
    return changed


def write_atomic(path, data, st):
    d = os.path.dirname(path)
    tmp = os.path.join(d, f".{os.path.basename(path)}.b245-{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chown(tmp, st.st_uid, st.st_gid)
        os.chmod(tmp, stat.S_IMODE(st.st_mode))
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def apply_edit(path, key, pat, value):
    raw = open(path, "rb").read()
    lines = raw.decode("utf-8").split("\n")
    idx = [i for i, l in enumerate(lines) if pat(l)]
    if len(idx) != 1:
        stop(f"{path} changed while running (matching lines: {len(idx)})")
    i = idx[0]
    old = lines[i]
    if key:
        k = old.split("=", 1)[0]
        _, q = env_value(old)
        lines[i] = f"{k}={q}{value}{q}"
    else:
        sep = re.match(r"^\S+(\s+)", old).group(1)
        lines[i] = f"{SASL_KEY}{sep}{USER}:{value}"
    new = "\n".join(lines).encode("utf-8")
    st = os.stat(path)
    write_atomic(path, new, st)
    back = open(path, "rb").read().decode("utf-8").split("\n")
    before = raw.decode("utf-8").split("\n")
    if back != lines or [j for j in range(len(back)) if back[j] != before[j]] != [i]:
        stop(f"{path}: read-back after the write does not match (only line {i + 1} may change)")
    st2 = os.stat(path)
    if (st2.st_uid, st2.st_gid, stat.S_IMODE(st2.st_mode)) != (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)):
        stop(f"{path}: owner/mode changed")


def current_value(path, key, pat):
    lines, idx = find_line(path, pat)
    l = lines[idx[0]]
    return env_value(l)[0] if key else l.split()[1].split(":", 1)[1]


# ---------------------------------------------------------------- tests of the new value (in this process only)
def test_mail(pw):
    try:
        with smtplib.SMTP("smtp.ionos.com", 587, timeout=30) as s:
            s.starttls(context=ssl.create_default_context())
            s.login(USER, pw)
        return True, "IONOS accepted the login"
    except smtplib.SMTPAuthenticationError as e:
        return False, f"IONOS refused the login ({e.smtp_code})"
    except Exception as e:
        return False, f"could not reach IONOS ({type(e).__name__})"


def test_explorer(tok):
    """lichess.org's own token test (POST /api/token/test, the token in the BODY): null = not a valid token. The explorer
    itself answers 200 even without a token today, so it cannot tell a good token from a bad one."""
    try:
        c = http.client.HTTPSConnection("lichess.org", timeout=30, context=ssl.create_default_context())
        c.request("POST", "/api/token/test", body=tok.encode(),
                  headers={"Content-Type": "text/plain", "User-Agent": "chesspuertoricocoffee.com chess-secret-set"})
        r = c.getresponse()
        d = json.loads(r.read(100000) or b"{}")
        info = d.get(tok) if isinstance(d, dict) else None
        if r.status == 200 and isinstance(info, dict) and info.get("userId"):
            return True, "lichess.org says the token is valid" + (" (no scopes)" if not info.get("scopes") else " (it HAS scopes - a token without scopes is enough)")
        return False, f"lichess.org says this is not a valid token (HTTP {r.status})"
    except Exception as e:
        return False, f"could not reach lichess.org ({type(e).__name__})"


# ---------------------------------------------------------------- lila recreate + checks
def lila_mode_now():
    a = run(["docker", "inspect", "-f", "{{.State.StartedAt}} {{.State.Pid}}", LILA_C], 20).stdout.strip()
    if not a or a.endswith(" 0"):
        return "none", a
    lg = run(["docker", "logs", "--since", a.split()[0], LILA_C], 30)
    b = run(["docker", "inspect", "-f", "{{.State.StartedAt}} {{.State.Pid}}", LILA_C], 20).stdout.strip()
    if a != b:
        return "none", b
    m = re.search(r"lila (Dev|Prod) / java", lg.stdout + lg.stderr)
    return (m.group(1) if m else "none"), a


def stop_lila_verified():
    while True:
        run(["docker", "stop", LILA_C], 150)
        r = run(["docker", "inspect", "-f", "{{.State.Running}} {{.State.Restarting}}", LILA_C], 20)
        if r.returncode == 0 and r.stdout.strip() == "false false":
            return
        if r.returncode != 0 and "No such" in r.stderr:
            return   # no container at all = not running
        say("   could not verify that lila stopped - retrying in 10 s")
        time.sleep(10)


