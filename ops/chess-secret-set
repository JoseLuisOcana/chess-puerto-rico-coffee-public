# ---------------------------------------------------------------- main
def ask(label, rule, rule_text):
    if not sys.stdin.isatty():
        refuse("run it in a terminal: the value is typed with hidden typing")
    def hidden(prompt):
        try:
            return getpass.getpass(prompt)
        except getpass.GetPassWarning:
            refuse("this terminal cannot hide the typing - use a normal SSH terminal")
        except (KeyboardInterrupt, EOFError):
            print()
            refuse("stopped (Ctrl+C)")
    for attempt in range(3):
        a = hidden(f"{label} (typing is hidden): ")
        if not rule.fullmatch(a):
            say(f"   not accepted: {rule_text}. Try again.")
            continue
        b = hidden("Type it again: ")
        if a != b:
            say("   the two did not match. Try again.")
            continue
        return a
    refuse("3 tries without a valid, matching value")


def main():
    global MODE
    args = sys.argv[1:]
    if args not in (["mail"], ["explorer"], ["--check"]):
        MODE = "-"
        print(__doc__.split("\n\n")[0] + "\n\n" + __doc__.split("\n\n")[1])
        sys.exit(2)
    MODE = args[0]
    globals()["CHECK_ONLY"] = MODE == "--check"
    if os.geteuid() != 0:
        print("REFUSED: run it with sudo - NOTHING changed")
        sys.exit(2)
    global LOCKS_HELD
    if MODE != "--check":   # --check changes nothing, so it needs no lock (the BUTTON 245 install calls it while holding the upgrade lock)
        for p in [LOCK] + OTHER_LOCKS:
            f = open(p, "a")
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                refuse(f"{p} is held (another chess-secret-set or a chess upgrade step is running)")
            LOCKS_HELD.append(f)   # held until this run ends
    if run(["docker", "context", "show"], 20).stdout.strip() != "default":
        refuse("the docker context is not default")
    if MODE == "--check":
        for m in ("mail", "explorer"):
            MODE = m
            check_files(m)
        MODE = "--check"
        if run(DC + ["config", "--quiet"], 120).returncode != 0:
            refuse("docker compose config fails")
        ok, names, rc = dry_run_ok()
        if not ok:
            refuse(f"the compose dry run for lila names {sorted(names) or 'nothing'} (exit {rc})")
        say("CHECK: every file and record is as expected; a real run would ask for the value now. NOTHING changed.")
        return
    check_files(MODE)
    ok, names, rc = dry_run_ok()
    if not ok:
        refuse(f"the compose dry run for lila names {sorted(names) or 'nothing'} (exit {rc}) - look first")
    log("start")
    g = games_now()
    if g != 0:
        say(f"{'Somebody is playing' if g > 0 else 'Could not count the games being played'}"
            f"{f' ({g} game(s) moved in the last 10 minutes)' if g > 0 else ''}. At the end lila restarts (~15 s); games continue after.")
        try:
            a = input("Go on now? [y/N] ").strip().lower()
        except EOFError:
            a = ""
        if a not in ("y", "yes", "s", "si"):
            refuse("stopped at your answer - run it again later")
    if MODE == "mail":
        say("New password of system@chesspuertoricocoffee.com - you must have changed it in IONOS already.")
        say("Allowed: 12-128 characters; letters, digits and  ! % & ( ) * + , - . / : < > ? @ [ ] ^ _ { | } ~")
        say("(not: spaces, quotes, backslash, $, #, `, =, ; - one of the 3 config files would read them differently)")
        val = ask("New system@ password", SAFE_PW, "12-128 characters from the list above")
        globals()["SECRET"] = val
        cur = [current_value(p, k, f) for p, k, f in plan_edits("mail")]
        if all(c == val for c in cur):
            say("   that is already the password in all 3 files - only the remaining steps run (Postfix, lila, chess-contact, test)")
        ok, why = test_mail(val)
    else:
        say("New lichess.org API token for the opening explorer: https://lichess.org/account/oauth/token/create - no scopes needed.")
        val = ask("New explorer token", SAFE_TOKEN, "16-128 letters, digits or _ (a lichess token looks like lip_...)")
        globals()["SECRET"] = val
        if current_value(*plan_edits("explorer")[0]) == val:
            say("   that is already the token in .env - only the remaining steps run (lila)")
        ok, why = test_explorer(val)
    say(f"1. test of the NEW value: {why}")
    if not ok:
        log(f"test FAILED {why}")
        refuse("the new value did not work" + (" - did you change it in IONOS first?" if MODE == "mail" else ""))
    log("test OK")
    for sg in (signal.SIGINT, signal.SIGHUP, signal.SIGTERM, signal.SIGQUIT):
        signal.signal(sg, signal.SIG_IGN)   # from the first change on, Ctrl+C / an SSH drop cannot stop it half-way
    say("   (from here on Ctrl+C does not stop it - every step is checked; it takes about 1 minute)")
    # backup copies of every file this run changes (root only)
    os.makedirs(RUNS, mode=0o700, exist_ok=True)
    os.chmod(RUNS, 0o700)
    rdir = tempfile.mkdtemp(prefix=f"{STAMP}-{MODE}-", dir=RUNS)   # a new 700 folder per run
    os.makedirs(os.path.join(rdir, "before"), mode=0o700)
    files = sorted({p for p, _, _ in plan_edits(MODE)} | {B236} | ({SASL + ".db"} if MODE == "mail" else set()))
    for p in files:
        dst = os.path.join(rdir, "before", p.lstrip("/"))
        os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
        shutil.copy2(p, dst)
        os.chmod(dst, 0o600)
    with open(os.path.join(rdir, "before.sha256"), "w") as f:
        f.write("".join(f"{sha(p)}  {p}\n" for p in files))
    say(f"2. copies of the {len(files)} files before the change: {rdir}/before/ (root only)")
    log(f"backup {rdir}")
    for path, key, pat in plan_edits(MODE):
        if current_value(path, key, pat) == val:
            say(f"   {path}: already the new value")
            continue
        apply_edit(path, key, pat, val)
        if current_value(path, key, pat) != val:
            stop(f"{path}: the new value is not there after the write")
        say(f"3. {path}: {key or 'the system@ line'} = the new value (no other line changed)")
        log(f"wrote {path} {key or 'system@ line'}")
    if renew_b236():
        say("4. BUTTON 236's compose-inputs record: the new .env checksum (every other compose input unchanged)")
        log("b236 record renewed")
    if MODE == "mail":
        n = rebuild_sasl_db()
        q = run(["/usr/sbin/postmap", "-q", SASL_KEY, "hash:" + SASL], 30)
        if q.stdout.strip() != f"{USER}:{val}":
            stop("Postfix's sasl_passwd.db does not hold the new system@ entry")
        r = run(["/usr/sbin/postfix", "reload"], 60)
        if r.returncode != 0:
            stop("postfix reload failed")
        say(f"5. Postfix: sasl_passwd.db rebuilt in a private copy, all {n} entries checked, swapped in; Postfix reloaded")
        log("postfix OK")
    recreate_lila()
    if MODE == "mail":
        r = run(["systemctl", "restart", "chess-contact.service"], 60)
        time.sleep(5)
        if r.returncode != 0 or run(["systemctl", "is-active", "chess-contact.service"], 20).stdout.strip() != "active":
            stop("chess-contact.service did not restart (sudo systemctl status chess-contact)")
        say("6. chess-contact.service restarted (active)")
        log("chess-contact restarted")
        r = run(["/usr/local/sbin/stuck-mail-check", "--logins"], 300)
        tail = [l for l in r.stdout.splitlines() if l.strip()][-14:]
        say("7. sudo stuck-mail-check --logins (login only, no e-mail):")
        for l in tail:
            say("   " + l)
        log(f"stuck-mail-check --logins exit {r.returncode}")
        if r.returncode != 0:
            stop("stuck-mail-check --logins did not say ALL OK - read the lines above")
    else:
        say("6. Now revoke the OLD token on https://lichess.org/account/oauth/token (the one made for this site).")
    say(f"DONE: {'system@ password' if MODE == 'mail' else 'explorer token'} changed everywhere; copies of the old files: {rdir}/before/")
    log("DONE")


