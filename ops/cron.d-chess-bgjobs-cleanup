# Weekly: delete stale sbt bg-jobs classpath copies of lila (~175 MB per restart) and lila-fishnet.
# Keeps any folder a running process uses (/proc check) — see the script header.
# Log: /var/log/chess-bgjobs-cleanup.log   Manual: chess-bgjobs-cleanup.sh --dry-run
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=admin@example.com   # sanitized: set your admin address
45 4 * * 0 root /usr/local/bin/chess-bgjobs-cleanup.sh >/dev/null
